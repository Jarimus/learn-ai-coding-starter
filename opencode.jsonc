{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    // Broad rule: every shell command needs approval.
    { "action": "shell", "resource": "*", "effect": "ask" },
    // Narrow exceptions below: the last matching rule wins.
    { "action": "shell", "resource": "bootdev run *", "effect": "allow" },
    { "action": "run_slop", "resource": "*", "effect": "allow" },
    // Block launching the explore subagent.
    { "action": "subagent", "resource": "explore", "effect": "deny" },
  ],
  "watcher": {
    "ignore": ["logs/**"],
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000,
    },
    "buffer": 20000,
  },
}
