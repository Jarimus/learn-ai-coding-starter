{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    // Narrow exceptions below: the last matching rule wins.
    { "action": "shell", "resource": "bootdev run *", "effect": "allow" },
    { "action": "run_slop", "resource": "*", "effect": "allow" },
    // Never read .env files.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    // Ask before loading this skill.
    { "action": "skill", "resource": "create-test-program", "effect": "ask" },
  ],
  "watcher": {
    "ignore": ["logs/**"],
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000,
    },
    "buffer": 20000,
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      }
    }
  },
}
